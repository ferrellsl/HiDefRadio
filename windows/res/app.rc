#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "HiDef Radio - HD Radio receiver for RTL-SDR"
            VALUE "FileVersion", "1.0.1"
            VALUE "ProductName", "HiDef Radio for Windows"
            VALUE "ProductVersion", "1.0.1"
            VALUE "LegalCopyright", "GPL-3.0-or-later. Based on HiDef Radio by derek20la."
            VALUE "OriginalFilename", "HiDefRadio.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_TUNE DIALOGEX 0, 0, 220, 78
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Tune to"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "FM in MHz (e.g. 101.1) or AM in kHz (e.g. 1260):", IDC_PROMPT, 10, 10, 200, 10
    EDITTEXT IDC_FREQ, 10, 24, 200, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Tune", IDOK, 106, 54, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 160, 54, 50, 14
END

IDD_RENAME DIALOGEX 0, 0, 220, 78
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Rename favorite"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Your name for this favorite. Leave it empty to use the station's name.", IDC_PROMPT, 10, 8, 200, 18
    EDITTEXT IDC_NAME, 10, 28, 200, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Save", IDOK, 106, 54, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 160, 54, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 300, 352
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Reception", -1, 7, 4, 286, 62
    LTEXT "Receiver:", -1, 14, 18, 70, 10
    COMBOBOX IDC_DEVICE, 90, 16, 196, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Tuner gain:", -1, 14, 34, 70, 10
    COMBOBOX IDC_GAIN, 90, 32, 196, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Auto measures the signal when you tune and keeps adjusting while you listen.", -1, 90, 48, 196, 16

    GROUPBOX "Audio", -1, 7, 70, 286, 96
    LTEXT "HD Radio:", -1, 14, 84, 70, 10
    COMBOBOX IDC_HDMODE, 90, 82, 196, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "HD isn't the analog:", -1, 14, 100, 74, 10
    COMBOBOX IDC_MISMATCH, 90, 98, 196, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Stereo:", -1, 14, 116, 70, 10
    COMBOBOX IDC_STEREO, 90, 114, 196, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "AM audio:", -1, 14, 132, 70, 10
    COMBOBOX IDC_AMBW, 90, 130, 196, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "AM de-emphasis (NRSC-1)", IDC_AMDEEMPH, 90, 148, 196, 10

    GROUPBOX "Pictures", -1, 7, 170, 286, 48
    LTEXT "", IDC_BLOCKED, 14, 184, 170, 10
    PUSHBUTTON "Clear blocked pictures", IDC_CLEARBLOCKED, 190, 181, 96, 14
    LTEXT "", IDC_LOGOS, 14, 202, 170, 10
    PUSHBUTTON "Clear saved logos", IDC_CLEARLOGOS, 190, 199, 96, 14

    GROUPBOX "Recording", -1, 7, 222, 286, 66
    LTEXT "Record button:", -1, 14, 236, 70, 10
    COMBOBOX IDC_RECWHAT, 90, 234, 196, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "IQ limit:", -1, 14, 252, 70, 10
    COMBOBOX IDC_RECLIMIT, 90, 250, 196, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "", IDC_RECFOLDER, 14, 270, 214, 10, SS_PATHELLIPSIS
    PUSHBUTTON "Folder...", IDC_RECBROWSE, 236, 267, 50, 14

    LTEXT "", IDC_ABOUT, 7, 292, 286, 38
    DEFPUSHBUTTON "OK", IDOK, 186, 332, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 243, 332, 50, 14
END
